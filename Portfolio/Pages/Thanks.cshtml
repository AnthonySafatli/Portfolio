@page
@model Portfolio.Pages.ThanksModel
@{
    ViewData["Title"] = "Contact Me";

    ViewData["Globe X"] = 0;
    ViewData["Globe Y"] = -0.5;
    ViewData["Globe Z"] = -3;
    ViewData["Globe Opacity"] = 0.075;

    ViewData["Robots"] = "noindex, nofollow";
}



@section Styles {
    <link rel="stylesheet" href="~/dist/css/thanks.min.css" asp-append-version="true" />
}

<div class="thanks-page">
    <span class="thanks-label">message sent</span>
    <h1 class="thanks-title">Thank You!</h1>

    <p class="thanks-sub">Your message has been received. I'll get back to you as soon as possible.</p>

    <div class="thanks-receipt">
        <div class="receipt-row">
            <span class="receipt-key">email</span>
            <span class="receipt-val">@TempData["Email"]</span>
        </div>
        <div class="receipt-row">
            <span class="receipt-key">message</span>
            <span class="receipt-val">@TempData["Message"]</span>
        </div>
    </div>

    <div class="thanks-actions">
        <a asp-page="/Index" class="button">Back to Home</a>
        <a asp-page="/Projects" class="button button-pink">View Projects</a>
    </div>
</div>