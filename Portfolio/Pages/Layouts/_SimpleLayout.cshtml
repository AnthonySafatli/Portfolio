<!DOCTYPE html>
<html>
<head>
    @* Meta *@
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    @* CSS *@
    @await RenderSectionAsync("Styles", required: false)

    @* Fonts *@
    @await RenderSectionAsync("Fonts", required: false)

    @* Umami *@
    <script defer src="https://analytics.anthonysafatli.ca/script.js" data-website-id="1f6912a9-63c6-44b0-8a28-12af8843e515"></script>
</head>
<body>
    @RenderBody()
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
