<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>
    @* Meta *@
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @await Html.PartialAsync("_LayoutMeta")

    <title>@ViewData["Title"] - Anthony Safatli</title>
    <link rel="icon" type="image/png" href="~/assets/globe icon.png">

    @* CSS *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/dist/css/global.min.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    @* Fonts *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
    href="https://fonts.googleapis.com/css2?family=Sora:wght@200;300;400;600&family=DM+Mono:wght@300;400&display=swap"
    rel="stylesheet">

    @* Umami *@
    <environment include="Production">
        <script defer src="https://analytics.anthonysafatli.ca/script.js"
                data-website-id="1f6912a9-63c6-44b0-8a28-12af8843e515"></script>
    </environment>
</head>

<body>
    <div id="tsparticles"></div>
    <canvas class="webgl"></canvas>

    <div class="container d-flex flex-column min-vh-100">
        <header class="my-4">
            <nav class="d-flex gap-4 align-items-center">
                <a class="nav-brand" asp-page="/Index">AS</a>
                <div class="d-flex gap-4 nav-links-top">
                    <a asp-page="/Projects">Projects</a>
                    <a asp-page="/AboutMe">About Me</a>
                    <a asp-page="/Contact">Contact</a>
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a asp-page="/Admin/Dashboard">Admin</a>
                    }
                </div>
            </nav>
        </header>

        <main class="flex-grow-1">
            @RenderBody()
        </main>

        <footer class="d-flex justify-content-between align-items-center mt-4 mb-3">
            <span class="footer-copy">&copy; @Html.Raw(DateTime.Now.Year) — Anthony Safatli</span>
            <nav class="d-flex gap-3 fs-4 footer-icons">
                <a href="https://github.com/AnthonySafatli" class="fa fa-github" target="_blank"></a>
                <a href="https://www.instagram.com/anthonysafatli124/" class="fa fa-instagram" target="_blank"></a>
                <a href="https://www.linkedin.com/in/anthony-safatli-755823296/" class="fa fa-linkedin"
                   target="_blank"></a>
                <a href="mailto:anthonysafatli@dal.ca" class="fa fa-envelope"></a>
            </nav>
        </footer>
    </div>

    @await Html.PartialAsync("_LayoutGlobe")
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>