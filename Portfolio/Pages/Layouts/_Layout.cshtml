<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    @* Meta *@
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @await Html.PartialAsync("_LayoutMeta")

    <title>@ViewData["Title"] - Anthony Safatli</title>
    <link rel="icon" type="image/png" href="~/assets/globe icon.png">

    @* CSS *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    @* Fonts *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
</head>
<body>
    <canvas class="webgl"></canvas>

    <div class="container d-flex flex-column min-vh-100">
        <header class="my-4">
            <nav class="d-flex gap-3">
                <a asp-page="/Index">Home</a>
                <a asp-page="/Projects">Projects</a>
                <a asp-page="/AboutMe">About Me</a>
                <a asp-page="/Contact">Contact</a>
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-page="/Admin/Dashboard">Admin</a>
                }
            </nav>
        </header>

        <main class="flex-grow-1">
            @RenderBody()
        </main>

        <footer class="d-flex justify-content-between align-items-center mt-4 mb-3">
            <span>
                &copy; 2024 - Anthony Safatli
            </span>

            <nav class="d-flex gap-3 fs-3">
                <a href="https://github.com/AnthonySafatli" class="fa fa-github" target="_blank"></a>
                <a href="https://www.instagram.com/anthonysafatli124/" class="fa fa-instagram" target="_blank"></a>
                <a href="https://www.linkedin.com/in/anthony-safatli-755823296/" class="fa fa-linkedin" target="_blank"></a>
                <a href="mailto:anthonysafatli@dal.ca" class="fa fa-envelope"></a>
            </nav>
        </footer>
    </div>

    @await Html.PartialAsync("_LayoutGlobe")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>