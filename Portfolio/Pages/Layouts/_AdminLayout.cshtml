<!DOCTYPE html>
<html>
<head>
    @* Meta *@
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - Admin</title>
    <link rel="icon" type="image/png" href="~/assets/globe icon admin.png">

    @* CSS *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    @* Fonts *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400..800&display=swap" rel="stylesheet">

    @* Umami *@
    <script defer src="https://analytics.anthonysafatli.ca/script.js" data-website-id="1f6912a9-63c6-44b0-8a28-12af8843e515"></script>
</head>
<body>
    <div id="tsparticles"></div>
    <canvas class="webgl"></canvas>

    <div class="container d-flex flex-column min-vh-100">
        <header class="my-4">
            <nav class="d-flex gap-3">
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-page="/Index">Home</a>
                    <a asp-page="/Admin/Dashboard">Dashboard</a>
                    <a asp-page="/Admin/Files/Index">File Manager</a>
                    <form method="post" asp-page="/Admin/Logout">
                        <button class="a" type="submit">Logout</button>
                    </form>
                } 
                else
                {
                    <p>Admin Zone</p>
                }
            </nav>
        </header>

        <main class="flex-grow-1">
            @RenderBody()
        </main>

        <footer class="d-flex justify-content-between align-items-center mt-4 mb-3">
            <span>
                &copy; 2024 - Anthony Safatli
            </span>
        </footer>
    </div>

    <script>var globePos = [0, -0.1, -4];</script>
    <script>var lowColour = [0.5, 0.5, 0.5]; var highColour = [0.9, 0.9, 0.9]; var wireColour = 0x303030;</script>
    <script>var globeOpacity = 0.3;</script>
    <script src="~/lib/tsparticles/tsparticles.bundle.min.js" asp-append-version="true"></script>
    <script src="~/dist/starfield.bundle.js" asp-append-version="true"></script>
    <script src="~/dist/background.bundle.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
