@page
@model IndexModel
@{
    ViewData["Title"] = "Home";

    ViewData["Globe X"] = -1;
    ViewData["Globe Y"] = 0;
    ViewData["Globe Z"] = -3.25;
    ViewData["Globe Opacity"] = 0.9;

    ViewData["Description"] = "Welcome to Anthony Safatli's portfolio. Aspiring software developer and Dalhousie University student. Explore my projects, learn about me, or get in touch!";
    ViewData["Keywords"] = "Anthony Safatli, Software Developer, Dalhousie University, Developer Portfolio, Programming Projects, About Anthony, Contact Anthony, Aspiring Developer";
    ViewData["Robots"] = "index, follow";
    ViewData["URL"] = "https://anthonysafatli.ca/";
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
}

<div class="row mt-5">
    <div class="col-6 offset-6 text-end">
        <div>
            <h1 class="hero">
                <span id="small" class="d-block">Hi</span>
                <span id="big" class="d-block">I'm Anthony</span>
            </h1>

            <p class="fs-4">Aspiring Software Developer & Current Dalhousie Student</p>
        </div>

        <div class="d-flex flex-column gap-2 fs-5 nav-links">
            <div><a asp-page="/Projects">Projects</a></div>
            <div><a asp-page="/AboutMe">About Me</a></div>
            <div><a asp-page="/Contact">Contact</a></div>
        </div>
    </div>
</div>