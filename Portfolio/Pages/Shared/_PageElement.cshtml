@using Portfolio.Models;
@model Portfolio.Models.PageElement

@{
    var imageExt = new[] { "jpg", "jpeg", "svg", "gif", "bmp", "png", "webp" };
    var videoExt = new[] { "mp4", "ogg", "webm" };

    string ext = Model.Text != null
        ? System.IO.Path.GetExtension(Model.Text).TrimStart('.').ToLower()
        : "";

    string classes = Model.Data == "true" ? "bordered" : ""; 
}

@if (Model.Type == PageElementType.HEADER)
{
    switch (Model.Data)
    {
        case "0":
            <h1>@Model.Text</h1>
            break;
        case "1":
            <h2>@Model.Text</h2>
            break;
        case "2":
            <h3>@Model.Text</h3>
            break;
        case "3":
            <h4>@Model.Text</h4>
            break;
        case "4":
            <h5>@Model.Text</h5>
            break;
        case "5":
            <h6>@Model.Text</h6>
            break;
    }
}
else if (Model.Type == PageElementType.QUOTE)
{
    <blockquote>@Model.Text</blockquote>
}
else if (Model.Type == PageElementType.LIST)
{
    @await Html.PartialAsync("_PageElementList", Model)
}
else if (Model.Type == PageElementType.MEDIA)
{
    if (imageExt.Contains(ext))
    {
        <div class="media-div">
            <img class="@classes"
                src="/projects@(Model.Text)"
                alt="@Model.SubElements[0].Text"
                loading="lazy" />
        </div>
    }
    else if (videoExt.Contains(ext))
    {
        <div class="media-div">
            <video class="@classes" controls>
                <source src="/projects@(Model.Text)" type="video/@(ext)" alt="@Model.SubElements[0].Text"/>
                @Model.Text
            </video>
        </div>
    }
}
else if (Model.Type == PageElementType.HORIZONTAL)
{
    <hr />
}
else if (Model.Type == PageElementType.CODE)
{
    <pre><code>
            @foreach (var item in Model.SubElements)
            {
                @Html.Raw(item.Text)
            }
    </code></pre>
}
else if (Model.Type == PageElementType.HTML)
{
    @foreach (var item in Model.SubElements)
    {
        @Html.Raw(item.Text)
    }
}
else if (Model.Type == PageElementType.PARAGRAPH)
{
    <p>
        @await Html.PartialAsync("_PageElementRichText", Model.SubElements)
    </p>
}
