@page
@model Portfolio.Pages.Admin.LoginModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Login";
}

@section Styles {
    <link rel="stylesheet" href="~/dist/css/admin/login.min.css" asp-append-version="true" />
}

<div class="login-page">
    <div class="login-box">
        <span class="login-label">admin access</span>
        <h1 class="login-title">Sign In</h1>

        <form method="post" class="login-form">
            <div class="login-field">
                <label asp-for="Credential.Password">Password</label>
                <input type="password" asp-for="Credential.Password" placeholder="••••••••" />
            </div>
            <button class="button" type="submit">Login</button>
        </form>
    </div>
</div>