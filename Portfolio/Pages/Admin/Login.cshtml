@page
@model Portfolio.Pages.Admin.LoginModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <form method="post" class="d-flex flex-column justify-content-center align-items-center gap-4 fs-4">
        <div>
            <div class="hstack gap-3">
                <label asp-for="Credential.Password"></label>
                <input type="password" asp-for="Credential.Password" />
            </div>
        </div>
        <div class="uninclude">
            <button class="button fs-5" type="submit">Login</button>
        </div>
    </form>
</div>