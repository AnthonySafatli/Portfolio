@page
@model Portfolio.Pages.Admin.Projects.CreateModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create";
}

<div class="container mt-5">
    <h1>Create Project</h1>

    <form method="post" class="vstack gap-3" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly"></div> 

        <div>
            <div class="d-flex align-items-center">
                <label class="flex-grow-1" asp-for="Project.Id"></label>
                <input asp-for="Project.Id"/>
            </div>
            <span class="text-danger" asp-validation-for="Project.Id"></span>
        </div>
            
        <div>
            <div class="d-flex align-items-center">
                <label class="flex-grow-1" asp-for="Project.DisplayName"></label>
                <input asp-for="Project.DisplayName" />
            </div>
            <span class="text-danger" asp-validation-for="Project.DisplayName"></span>
        </div>

        <div>
            <div class="d-flex align-items-center">
                <label class="flex-grow-1" asp-for="Project.DateStarted"></label>
                <input asp-for="Project.DateStarted"/>
            </div>
            <span class="text-danger" asp-validation-for="Project.DateStarted"></span>
        </div>

        <div>
            <div class="d-flex align-items-center">
                <label class="flex-grow-1" asp-for="Project.DateEnded"></label>
                <input asp-for="Project.DateEnded"/>
            </div>
            <span class="text-danger" asp-validation-for="Project.DateEnded"></span>
        </div>

        <div>
            <div class="d-flex align-items-center">
                <label class="flex-grow-1" asp-for="PageContentFile"></label>
                <input asp-for="PageContentFile" />
            </div>
            <span class="text-danger" asp-validation-for="PageContentFile"></span>
        </div>

        <div>
            <div class="d-flex align-items-center">
                <label class="flex-grow-1" asp-for="Project.Thumbnail"></label>
                <input asp-for="Project.Thumbnail" accept=".json, .txt" />
            </div>
            <span class="text-danger" asp-validation-for="Project.Thumbnail"></span>
        </div>

        <div class="d-flex align-items-center">
            <label class="flex-grow-1" asp-for="Project.Hidden"></label>
            <input asp-for="Project.Hidden"/>
        </div>

        <div>
            <div class="d-flex align-items-center ">
                <label class="flex-grow-1" asp-for="Project.SortOrder"></label>
                <input asp-for="Project.SortOrder" />
            </div>
            <span class="text-danger" asp-validation-for="Project.SortOrder"></span>
        </div>

        <div>
            <div class="d-flex flex-column align-items-center gap-2">
                <label class="w-100 text-start" asp-for="Project.Description"></label>
                <textarea asp-for="Project.Description"></textarea>
            </div>
            <span class="text-danger" asp-validation-for="Project.Description"></span>
        </div>

        <div>
            <div class="d-flex align-items-center">
                <label class="flex-grow-1" asp-for="Project.Github"></label>
                <input asp-for="Project.Github" />
            </div>
            <span class="text-danger" asp-validation-for="Project.Github"></span>
        </div>

        <div>
            <div class="d-flex align-items-center">
                <label class="flex-grow-1" asp-for="Project.Page"></label>
                <input asp-for="Project.Page" />
            </div>
            <span class="text-danger" asp-validation-for="Project.Page"></span>
        </div>

        <div>
            <div class="d-flex align-items-center">
                <label class="flex-grow-1" asp-for="Project.Download"></label>
                <input asp-for="Project.Download" />
            </div>
            <span class="text-danger" asp-validation-for="Project.Download"></span>
        </div>

        <div class="uninclude">
            <button class="button" type="submit">Create</button>
        </div>
    </form>

    <div class="mt-4">
        <a asp-page="/Admin/Dashboard">Back To Dashboard</a>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
