@page
@model Portfolio.Pages.Admin.DashboardModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/dist/css/admin/dashboard.min.css" asp-append-version="true" />
}

<div class="dash-page">
    <div class="dash-header">
        <span class="dash-label">admin</span>
        <h1 class="dash-title">Dashboard</h1>
    </div>

    @if (Model.NewMessages.Count > 0)
    {
        <div class="dash-alert">
            <div class="dash-alert-inner">
                <i class="fa fa-exclamation-circle"></i>
                <span>
                    You have
                    <strong>@Model.NewMessages.Count</strong>
                    unread message@(Model.NewMessages.Count == 1 ? "" : "s")
                </span>
                <a asp-page="/Admin/Messages/Index" class="dash-alert-link">View all</a>
            </div>

            <div class="dash-messages">
                @foreach (var message in Model.NewMessages)
                {
                    <a asp-page="/Admin/Messages/View" asp-route-id="@message.Id" class="dash-message-row no-glow">
                        <span class="msg-email">@message.Email</span>
                        <span class="msg-text">
                            @(message.Text?.Length > 80 ? message.Text.Substring(0, 80) + "…" : message.Text)
                        </span>
                        <span class="msg-date">@message.SubmissionTime.ToString("MMM dd")</span>
                    </a>
                }
            </div>
        </div>
    }

    <div class="dash-cards">
        <div class="dash-card">
            <div class="dash-card-icon"><i class="fa fa-code"></i></div>
            <div class="dash-card-body">
                <span class="dash-card-label">projects</span>
                <span class="dash-card-value">@Model.Projects.Count</span>
            </div>
            <div class="dash-card-links">
                <a asp-page="/Admin/Projects/Index">View</a>
                <a asp-page="/Admin/Projects/Create">+ Add</a>
            </div>
        </div>

        <div class="dash-card">
            <div class="dash-card-icon"><i class="fa fa-tags"></i></div>
            <div class="dash-card-body">
                <span class="dash-card-label">tech stack items</span>
                <span class="dash-card-value">@Model.TechStackItems.Count</span>
            </div>
            <div class="dash-card-links">
                <a asp-page="/Admin/TechStackItems/Index">View</a>
                <a asp-page="/Admin/TechStackItems/Create">+ Add</a>
            </div>
        </div>

        <div class="dash-card">
            <div class="dash-card-icon"><i class="fa fa-envelope"></i></div>
            <div class="dash-card-body">
                <span class="dash-card-label">unread messages</span>
                <span class="dash-card-value">@Model.NewMessages.Count</span>
            </div>
            <div class="dash-card-links">
                <a asp-page="/Admin/Messages/Index">View →</a>
            </div>
        </div>

        <div class="dash-card">
            <div class="dash-card-icon"><i class="fa fa-folder"></i></div>
            <div class="dash-card-body">
                <span class="dash-card-label">file manager</span>
                <span class="dash-card-value">—</span>
            </div>
            <div class="dash-card-links">
                <a asp-page="/Admin/Files/Index">Open →</a>
            </div>
        </div>
    </div>
</div>