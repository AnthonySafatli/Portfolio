@page
@model Portfolio.Pages.Admin.Files.UploadModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Upload Media";
}

<div class="container mt-5">
    <h1>Upload Media File</h1>

    <form method="post" class="vstack gap-3" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly"></div>

        <div>
            <div class="d-flex align-items-center">
                <label class="flex-grow-1" asp-for="File"></label>
                <input asp-for="File" accept=".jpg, .png" />
            </div>
            <span class="text-danger" asp-validation-for="File"></span>
        </div>

        <div>
            <div class="d-flex align-items-center">
                <label class="flex-grow-1" asp-for="FileLocation"></label>
                <input asp-for="FileLocation" />
            </div>
            <span asp-validation-for="FileLocation"></span>
        </div>

        <div>
            <div class="d-flex align-items-center">
                <label class="flex-grow-1" asp-for="Name"></label>
                <input asp-for="Name" />
            </div>
            <span asp-validation-for="Name"></span>
        </div>

        <div class="uninclude">
            <button class="button" type="submit">Upload</button>
        </div>
    </form>

    <div class="mt-4">
        <a asp-page="/Admin/Dashboard">Back To Dashboard</a>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
