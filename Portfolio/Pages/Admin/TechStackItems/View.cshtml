@page
@model Portfolio.Pages.Admin.TechStackItems.ViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "View";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-content-center">
        <h1>View Tech Stack Item</h1>

        <form asp-page="Delete" method="post">
            <input type="hidden" asp-for="TechStackItem.Id" />
            <div class="uninclude">
                <button class="button button-danger" type="submit">Delete Item</button>
            </div>
        </form>
    </div>

    <form method="post" class="vstack gap-3" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly"></div>

        <div>
            <div class="d-flex align-items-center">
                <label class="flex-grow-1" asp-for="TechStackItem.Name"></label>
                <input readonly asp-for="TechStackItem.Name"/>
                <input type="hidden" asp-for="TechStackItem.Id" />
            </div>
            <span asp-validation-for="TechStackItem.Name"></span>
        </div>

        <div>
            <div class="d-flex align-items-center">
                <label class="flex-grow-1" asp-for="TechStackItem.PathToImage"></label>
                <input asp-for="TechStackItem.PathToImage" />
            </div>
            <span asp-validation-for="TechStackItem.PathToImage"></span>
        </div>

        <div class="uninclude">
            <button class="button" type="submit">Update</button>
        </div>
    </form>

    <div class="mt-4">
        <a asp-page="/Admin/Dashboard">Back To Dashboard</a>
    </div>
    
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
