@page
@model Portfolio.Pages.Admin.TechStackItems.CreateModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create";
}

<div class="container mt-5">
    <h1>Create Tech Stack Item</h1>

    <form method="post" class="vstack gap-3" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly"></div>

        <div>
            <div class="d-flex align-items-center">
                <label class="flex-grow-1" asp-for="TechStackItem.Name"></label>
                <input asp-for="TechStackItem.Name" />
            </div>
            <span class="text-danger" asp-validation-for="TechStackItem.Name"></span>
        </div>

        <div>
            <div class="d-flex align-items-center">
                <label class="flex-grow-1" asp-for="TechStackItem.PathToImage"></label>
                <input asp-for="TechStackItem.PathToImage" />
            </div>
            <span class="text-danger" asp-validation-for="TechStackItem.PathToImage"></span>
        </div>
        
        <div class="uninclude">
            <button class="button" type="submit">Create</button>
        </div>
    </form>

    <div class="mt-4">
        <a asp-page="/Admin/Dashboard">Back To Dashboard</a>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
