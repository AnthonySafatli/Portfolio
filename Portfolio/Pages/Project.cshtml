@page "{name}"
@using Portfolio.Models
@model Portfolio.Pages.ProjectModel
@{
    ViewData["Title"] = Model.Project?.DisplayName;

    ViewData["Globe X"] = 0;
    ViewData["Globe Y"] = -0.5;
    ViewData["Globe Z"] = -3;
    ViewData["Globe Opacity"] = 0.15;

    ViewData["Description"] = Model.Project?.Description;
    ViewData["Robots"] = "index, follow";
}

@section Styles {
    <link rel="stylesheet" href="~/dist/css/project.min.css" asp-append-version="true" />
}

<div class="mt-5">
    <h1 class="text-center">@Model.Project.DisplayName</h1>

    <div class="d-flex flex-wrap justify-content-center gap-4 mb-3 mt-3">
        @if (!String.IsNullOrEmpty(Model.Project.Github))
        {
            <a href="@Model.Project.Github" target="_blank">
                <i class="fa fa-mini fa-github"></i>&nbsp;&nbsp;Github
            </a>
        }
        @if (!String.IsNullOrEmpty(Model.Project.Page))
        {
            <a href="@Model.Project.Page" target="_blank">
                <i class="fa fa-mini fa-globe"></i>&nbsp;&nbsp;Webpage
            </a>
        }
        @if (!String.IsNullOrEmpty(Model.Project.Download))
        {
            <a href="@Model.Project.Download" target="_blank">
                <i class="fa fa-mini fa-download"></i>&nbsp;&nbsp;Download
            </a>
        }
    </div>

    <div class="d-flex flex-wrap justify-content-around gap-2 mt-2 px-3 small">
        <span>
            Date Started: <span class="bolder fw-medium">@Model.Project.DateStarted.ToString("MMMM yyyy")</span>
        </span>
        <span>
            Date Ended: <span class="bolder fw-medium">@Model.Project.DateEnded.ToString("MMMM yyyy")</span>
        </span>
    </div>

    <div class="container mt-5 d-flex justify-content-center">
        <div id="project-page">
            @foreach (PageElement element in Model.ProjectPage.Elements)
            {
                @await Html.PartialAsync("_PageElement", element)
            }
        </div>
    </div>
</div>