@page "{name}"
@using Portfolio.Models
@model Portfolio.Pages.ProjectModel
@{
    ViewData["Title"] = Model.Project?.DisplayName;

    ViewData["Globe X"] = 0;
    ViewData["Globe Y"] = -0.5;
    ViewData["Globe Z"] = -3;
    ViewData["Globe Opacity"] = 0.15;

    ViewData["Description"] = Model.Project?.Description;
    ViewData["Robots"] = "index, follow";
}
@section Styles {
    <link rel="stylesheet" href="~/dist/css/project.min.css" asp-append-version="true" />
}

<div class="project-page">

    <div class="project-hero">

        <div class="project-hero-inner">
            <span class="project-hero-label">project</span>
            <h1 class="project-hero-title">@Model.Project.DisplayName</h1>
            <p class="project-hero-desc">@Model.Project.Description</p>

            <div class="project-meta-row">
                @if (Model.Project.DateStarted.HasValue)
                {
                    <span class="project-date">
                        @Model.Project.DateStarted.Value.ToString("MMM yyyy")
                        @if (Model.Project.DateEnded.HasValue)
                        {
                            <span> — @Model.Project.DateEnded.Value.ToString("MMM yyyy")</span>
                        }
                        else
                        {
                            <span> — Present</span>
                        }
                    </span>
                }

                @if (Model.Project.TechStackItems?.Any() == true)
                {
                    <div class="project-tags">
                        @foreach (var tech in Model.Project.TechStackItems)
                        {
                            <img src="@tech.PathToImage" alt="@tech.Name" title="@tech.Name" />
                        }
                    </div>
                }
            </div>

            <div class="project-links">
                @if (!string.IsNullOrEmpty(Model.Project.Github))
                {
                    <a href="@Model.Project.Github" target="_blank" class="project-link">
                        <span class="fa fa-github"></span> GitHub
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.Project.Page))
                {
                    <a href="@Model.Project.Page" target="_blank" class="project-link">
                        <span class="fa fa-globe"></span> Live Site
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.Project.Download))
                {
                    <a href="@Model.Project.Download" target="_blank" class="project-link">
                        <span class="fa fa-download"></span> Download
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="project-divider"></div>

    <div class="project-content">
        <div id="project-page">
            @foreach (PageElement element in Model.ProjectPage.Elements)
            {
                @await Html.PartialAsync("_PageElement", element)
            }
        </div>
    </div>

</div>