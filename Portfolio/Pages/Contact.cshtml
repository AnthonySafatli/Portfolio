@page
@model Portfolio.Pages.ContactModel
@{
    ViewData["Title"] = "Contact Me";

    ViewData["Globe X"] = 0;
    ViewData["Globe Y"] = -0.5;
    ViewData["Globe Z"] = -3;
    ViewData["Globe Opacity"] = 0.075;

    ViewData["Description"] = "Get in touch with Anthony Safatli, a passionate software developer and Dalhousie University student. Send a message through the contact form or email directly at AnthonySafatli@dal.ca.";
    ViewData["Keywords"] = "Contact Anthony, Contact Form, Email Anthony, Software Developer, Dalhousie University, Anthony Safatli, Message Anthony, Get in Touch";
    ViewData["Robots"] = "index, follow";
    ViewData["URL"] = "https://anthonysafatli.ca/Contact";
}

@section Styles {
    <link rel="stylesheet" href="~/css/contact.css" asp-append-version="true" />
}

<div class="container mt-5">
    <div class="text-center">
        <h1>Contact Me</h1>
        <p class="mt-3 mb-0">Send me a message here or mail me directly at</p>
        <a href="mailto:anthonysafatli@dal.ca">AnthonySafatli@dal.ca</a>
    </div>

    <form method="post" class="mt-3 d-flex flex-column justify-content-center align-items-center text-center">
        <div class="mt-3">
            <label class="mb-2">Email</label>
            <input type="email" asp-for="Message.Email" placeholder="example@@website.ca"/>
        </div>
    
        <div class="mt-3">
            <label class="mb-2">Message</label>
            <textarea asp-for="Message.Message" placeholder="I really like your website!" required></textarea>
        </div>
    
        <div class="d-flex justify-content-center mt-4">
            <input type="submit" class="button" />
        </div>
    </form>
</div>